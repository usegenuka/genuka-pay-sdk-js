{
  "name": "@genuka/pay-sdk",
  "version": "0.2.0",
  "description": "Server-side TypeScript SDK for the Genuka Pay API.",
  "type": "module",
  "packageManager": "pnpm@10.33.2",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "node --test --import tsx --import tsconfig-paths/register test/*.test.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "changeset": "changeset",
    "version": "changeset version",
    "release": "pnpm build && changeset publish"
  },
  "keywords": [
    "genuka",
    "payments",
    "mobile-money",
    "sdk"
  ],
  "license": "SEE LICENSE IN LICENSE",
  "devDependencies": {
    "@changesets/cli": "^2.31.0",
    "@types/node": "^22.19.20",
    "tsconfig-paths": "^4.2.0",
    "tsup": "^8.5.1",
    "tsx": "^4.22.4",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=22.13"
  }
}
